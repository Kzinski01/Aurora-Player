{
  "name": "aurora-desktop",
  "version": "0.10.1",
  "description": "Player de mídia com biblioteca local, downloads e editor de cortes.",
  "main": "src/main/main.js",
  "author": "Kzinski01",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev:renderer": "npm --prefix src/renderer run dev",
    "build:renderer": "npm --prefix src/renderer run build",
    "dist": "npm run build:renderer && npm run prepare:binaries && electron-builder --config electron-builder.config.js --publish never",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:unit": "node --test tests/unit/*.test.cjs",
    "prepare:binaries": "node scripts/prepare-binaries.cjs"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.4",
    "aurora-core": "file:vendor/aurora-core",
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^26.17.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Kzinski01/Aurora-Player.git"
  },
  "homepage": "https://github.com/Kzinski01/Aurora-Player",
  "bugs": {
    "url": "https://github.com/Kzinski01/Aurora-Player/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "global-agent": "^4.1.3"
  }
}
